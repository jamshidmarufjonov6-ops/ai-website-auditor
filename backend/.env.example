MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Optional: Stripe credit packs (leave empty to disable payments) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CREDIT_PACK_PRICE_ID=price_...
# STRIPE_SUCCESS_URL=http://localhost:3000/credits?billing=success
# STRIPE_CANCEL_URL=http://localhost:3000/credits?billing=cancelled

# --- Admin / contact system ---
# This account gets access to the admin panel (/admin) and receives
# forwarded contact-form messages.
ADMIN_EMAIL=you@gmail.com

# Optional Gmail auto-forward. Create a free App Password at:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=<16-character-app-password>
