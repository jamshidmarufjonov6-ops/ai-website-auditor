# --- Backend ---
# Environment: development | production
ENVIRONMENT=development

# Database: SQLite for local dev by default; PostgreSQL in production.
DATABASE_URL=sqlite:///./auditor.db
# Render's postgres:// URL is auto-converted to postgresql+psycopg:// by the app.
# DATABASE_URL=postgresql+psycopg://auditor:auditor@localhost:5432/auditor

# When true, the app runs `alembic upgrade head` on startup instead of
# create_all. Enable in production. Keep false for local dev databases that
# were created by create_all (use `alembic stamp head` once instead).
RUN_MIGRATIONS_ON_STARTUP=false

# Redis (reserved for future queue/cache use; optional in MVP)
REDIS_URL=redis://localhost:6379/0

# CORS origins (comma separated). Only needed if the frontend calls the API
# directly instead of through the Next.js rewrite proxy.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Crawler limits
MAX_PAGES=5
MAX_CRAWL_DEPTH=1
MAX_RESPONSE_BYTES=5242880
REQUEST_TIMEOUT_SECONDS=15
MAX_CONCURRENT_AUDITS=2

# Rate limiting
RATE_LIMIT_AUDIT_PER_HOUR=20
RATE_LIMIT_AUDIT_PER_MINUTE=4
RATE_LIMIT_AUTH_PER_MINUTE=10

# AI provider: none | deepseek | openai | anthropic
# "none" uses the built-in rules engine (works with no API key).
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Stripe (test mode; leave empty for local development without billing) ---
# Get test keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_CURRENCY=usd
STRIPE_BILLING_SUCCESS_URL=http://localhost:3000/dashboard?billing=success
STRIPE_BILLING_CANCEL_URL=http://localhost:3000/pricing?billing=cancelled

# Plan limits (used when Stripe is not configured or as a safety net)
FREE_PLAN_MONTHLY_AUDITS=3
FREE_PLAN_MAX_PAGES=5
PRO_PLAN_MONTHLY_AUDITS=30
PRO_PLAN_MAX_PAGES=20
PRO_PLAN_MONTHLY_PRICE_USD=19

# --- Frontend ---
# Leave empty to use the Next.js rewrite proxy (BACKEND_URL below is used server-side).
NEXT_PUBLIC_API_URL=
# Backend origin used by the Next.js dev/prod server rewrite proxy.
BACKEND_URL=http://localhost:8000
