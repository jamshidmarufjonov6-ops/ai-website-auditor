# Minimal configuration — nothing else is needed.

# MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Optional: Stripe credit packs (leave empty to disable payments) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CREDIT_PACK_PRICE_ID=price_...
# STRIPE_SUCCESS_URL=http://localhost:3000/credits?billing=success
# STRIPE_CANCEL_URL=http://localhost:3000/credits?billing=cancelled
